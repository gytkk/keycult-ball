/* Pin-map reference only. Not a compiled/validated QMK keyboard port. */
#pragma once
#define MATRIX_ROWS 5
#define MATRIX_COLS 15
#define MATRIX_ROW_PINS { GP4, GP5, GP6, GP7, GP8 }
#define MATRIX_COL_PINS { GP9, GP10, GP11, GP12, GP13, GP14, GP15, GP16, GP17, GP18, GP19, GP20, GP21, GP22, GP26 }
/* Both variants omit r4c7. Keycult62 has no COL7 switches; GP16 is NC. */
#define DIODE_DIRECTION COL2ROW
/* Reserved SPI0, MCU-side 3V3 testpads. Do not connect a 5V module. */
#define SPI_DRIVER SPID0
#define SPI_SCK_PIN GP2
#define SPI_MOSI_PIN GP3
#define SPI_MISO_PIN GP0
#define PMW33XX_CS_PIN GP1
/* GP23 motion and GP24 reset reserved; GP25/27/28/29 explicitly NC. */
